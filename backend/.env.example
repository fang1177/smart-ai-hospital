# Smart Hospital AI - Environment Variables
# Copy this to .env and fill in your values

# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smarthospital?retryWrites=true&w=majority
MONGO_URI=

# JWT Secret Key (use a secure random string)
JWT_SECRET=supersecret_smarthospital_jwt_key_2026

# Node Environment
NODE_ENV=development

# Optional Third-Party Services
# OpenAI (for AI Doctor Assistant & Triage)
OPENAI_API_KEY=

# Deepgram (for Voice Speech-to-Text)
DEEPGRAM_API_KEY=

# Razorpay (for online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase (Phase 2 notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
